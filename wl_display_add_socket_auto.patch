diff --git a/waywall/main.c b/waywall/main.c
index bd2195d..8211b68 100644
--- a/waywall/main.c
+++ b/waywall/main.c
@@ -1,3 +1,4 @@
+#define _GNU_SOURCE
 #include "config/config.h"
 #include "env_reexec.h"
 #include "inotify.h"
@@ -21,6 +22,39 @@
 #include <unistd.h>
 #include <wayland-server-core.h>
 
+const char*
+wl_display_add_socket_auto_fixed(struct wl_display *display) {
+    const char *runtime_dir = getenv("XDG_RUNTIME_DIR");
+
+    if (!runtime_dir || !runtime_dir[0])
+        return 0;
+
+    for (int i = 0; i <= 32; ++i) {
+        char *path;
+        if (asprintf(&path, "%s/wayland-%d", runtime_dir, i) == -1)
+            return 0;
+
+        if (access(path, F_OK) != 0) {
+            char *socket_name;
+            if (asprintf(&socket_name, "wayland-%d", i) == -1) {
+                free(path);
+                return 0;
+            }
+
+            free(path);
+            if (wl_display_add_socket(display, socket_name) == -1) {
+                free(socket_name);
+                return 0;
+            }
+            return socket_name;
+        }
+
+        free(path);
+    }
+
+    return 0;
+}
+
 struct waywall {
     struct config *cfg;
     struct reload *reload;
